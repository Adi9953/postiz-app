# ==============================================================================
# Postiz Production Environment Configuration (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this file to your local development environment or paste into Dockploy
#    environment variables.
# 2. Fill in the placeholder values with your real credentials.
# 3. NEVER commit real secrets or credentials into version control.
# ==============================================================================

# ==============================================================================
# 1. Container & Deployment Configuration (Dockploy)
# ==============================================================================
# GHCR repository in lowercase (<github-owner>/postiz-app)
GHCR_REPO=adi9953/postiz-app

# Immutable version tag deployed in production (DO NOT use 'latest' in production)
POSTIZ_VERSION=v1.47.0

# Port mapped on the VPS host (Dockploy Traefik reverse-proxies to this port)
POSTIZ_PORT=5000

# ==============================================================================
# 2. Required Application URLs
# CRITICAL: Do NOT include trailing slashes on these URLs!
# ==============================================================================
# The primary public URL where your Postiz instance is hosted
MAIN_URL=https://postiz.yourdomain.com

# Public frontend URL (same as MAIN_URL for standard deployments)
FRONTEND_URL=https://postiz.yourdomain.com

# Public API URL used by the browser to communicate with the backend
NEXT_PUBLIC_BACKEND_URL=https://postiz.yourdomain.com/api

# Internal backend URL used by Next.js Server-Side Rendering (SSR)
# Since frontend and backend run inside the same container, leave as localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000

# ==============================================================================
# 3. Security & Authentication
# ==============================================================================
# Generate a strong, random 64+ character secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_string

# Set to true for Postiz self-hosted installation (mandatory)
IS_GENERAL=true

# Set to true to close public signups once your administrator account is created
DISABLE_REGISTRATION=false

# ==============================================================================
# 4. External Databases (Neon & Redis Cloud)
# ==============================================================================
# External Neon PostgreSQL connection string (must include ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# External Redis Cloud connection string (must start with redis://)
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@redis-12345.c10.us-east-1-2.ec2.redns.redis-cloud.com:12345

# ==============================================================================
# 5. Cloudflare R2 Object Storage
# ==============================================================================
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_BUCKETNAME=postiz-media
# Public access URL (either your custom domain or Cloudflare r2.dev domain; NO trailing slash)
CLOUDFLARE_BUCKET_URL=https://pub-yourbucketid.r2.dev
CLOUDFLARE_REGION=auto

# ==============================================================================
# 6. Internal Temporal PostgreSQL Database
# (Private to Docker network, never exposed to host/internet)
# ==============================================================================
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=replace_with_a_secure_temporal_internal_password

# ==============================================================================
# 7. Optional: Email & Transactional Notifications (Resend)
# If left commented out, user accounts activate automatically without email verification.
# ==============================================================================
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM_ADDRESS=notifications@yourdomain.com
# EMAIL_FROM_NAME="Postiz"

# ==============================================================================
# 8. Optional: AI Features (OpenAI)
# ==============================================================================
# OPENAI_API_KEY=sk-your_openai_api_key

# ==============================================================================
# 9. Optional: Social Media API Providers
# Only configure the platforms you intend to connect. Unused platforms remain empty.
# ==============================================================================
# X (Twitter)
# X_API_KEY=
# X_API_SECRET=

# LinkedIn
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Facebook & Instagram
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Threads
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# YouTube
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# TikTok
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=

# Pinterest
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=

# Reddit
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Mastodon
# MASTODON_URL=https://mastodon.social
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
